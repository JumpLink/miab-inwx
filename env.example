# MIAB (Mail-in-a-Box) Configuration
MIAB_URL=https://box.example.com/admin
MIAB_USERNAME=admin@example.com
MIAB_PASSWORD=your-miab-password

# INWX OTE (Test Environment) Configuration
INWX_OTE_USERNAME=your-inwx-ote-username
INWX_OTE_PASSWORD=your-inwx-ote-password
INWX_OTE_SHARED_SECRET=your-2fa-secret-for-ote

# INWX LIVE (Production Environment) Configuration
INWX_LIVE_USERNAME=your-inwx-live-username
INWX_LIVE_PASSWORD=your-inwx-live-password
INWX_LIVE_SHARED_SECRET=your-2fa-secret-for-live

# Instructions:
# 1. Copy this file to .env in your project root (not in apps/cli)
# 2. Replace the example values with your actual credentials
# 3. Never commit .env to version control
# 4. Use CLI arguments to specify environment (--environment ote|live) and verbosity (--verbose)
# 5. The environment selection determines which set of credentials to use
#    - Use --environment ote for testing with OTE credentials
#    - Use --environment live for production with LIVE credentials
#    - If no environment is specified, defaults to 'ote' for safety 