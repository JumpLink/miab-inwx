{
	"name": "@miab-inwx/cli",
	"version": "1.0.0",
	"description": "A CLI for the MIAB and INWX API",
	"main": "src/index.ts",
	"type": "module",
	"bin": {
		"miab-cli": "node --experimental-specifier-resolution=node --experimental-strip-types --experimental-transform-types --no-warnings ./src/index.ts"
	},
	"scripts": {
		"start": "node --experimental-specifier-resolution=node --experimental-strip-types --experimental-transform-types --no-warnings ./src/index.ts",
		"check:types": "tsc"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^1.49.0",
		"@inquirer/prompts": "^7.8.4",
		"@miab-inwx/inwx-client": "workspace:*",
		"@miab-inwx/miab-client": "workspace:*",
		"domrobot-client": "^3.3.0",
		"minimatch": "^10.0.3",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@types/minimatch": "^6.0.0",
		"@types/node": "^24.3.1",
		"@types/yargs": "^17.0.33",
		"typescript": "^5.9.2"
	}
}
